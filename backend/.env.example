# Copy this file to .env and fill in your own values.
# Never commit a real .env file -- it contains secrets.

PROJECT_NAME="Chronicle API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

CORS_ORIGINS="*"

# MongoDB Atlas (or local) connection string
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0"
DATABASE_NAME="Chronicle"

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

HUGGINGFACE_API_KEY=
WHISPER_MODEL="openai/whisper-large-v3-turbo"
TTS_MODEL="facebook/mms-tts-eng"
HF_TIMEOUT=300

LLM_PROVIDER="gemini"
LLM_API_KEY=
LLM_MODEL="gemini-2.0-flash"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600
CONVERSATION_HISTORY_SIZE=12

MEDIA_ROOT="media"
MAX_AUDIO_FILE_SIZE_MB=25
