# Copy this file to .env and point it at your backend.
#
# - iOS simulator / web: http://localhost:8000/api/v1 works fine.
# - Physical device or Android emulator: use your computer's LAN IP, e.g.
#   http://192.168.1.23:8000/api/v1 (Android emulator: http://10.0.2.2:8000/api/v1)
#
# Expo only exposes env vars prefixed with EXPO_PUBLIC_ to app code.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
